# Reference only: Spring Boot does not automatically load .env files.
# Export these variables in your terminal or set them in your IDE/secret manager.
DB_URL=jdbc:mysql://127.0.0.1:3306/skillswap?connectionTimeZone=UTC
DB_USERNAME=
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
PORT=8080
COOKIE_SECURE=false

# Google Meet is optional. Use your own OAuth Web Application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/google/callback

# Required only with the vercel profile: base64 of 32 cryptographically random bytes.
CREDLEARN_SESSION_KEY=

# Managed privately by the deployment owner. Unset/zero disables admin access.
CREDLEARN_ADMIN_OWNER_USER_ID=
